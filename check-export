#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///

"""Checks that `external/` holds an export as the private repository produced it.

The export comes from a committed and pushed state, and every file under `external/` is listed
in `external/EXPORT.toml` with the checksum it had when it was written. Runs on GitHub for every
push; locally it works the same.

usage: ./check-export [checkout of PowerDynamicsReferences]
"""

import hashlib
import re
import sys
import tomllib
from pathlib import Path


def check(root):
    external = root / "external"
    record_file = external / "EXPORT.toml"
    if not record_file.is_file():
        return [f"{record_file} is missing"]
    with open(record_file, "rb") as io:
        record = tomllib.load(io)

    problems = []
    source = record.get("source")
    if source == "dirty":
        problems.append("the export came from uncommitted changes in the private repository "
                        "(source = \"dirty\")")
    elif not (isinstance(source, str) and re.fullmatch(r"[0-9a-f]{40}", source)):
        problems.append(f"source is not a commit sha: {source!r}")
    if record.get("pushed") is not True:
        problems.append("the private commit was not pushed when the export ran (pushed = false)")

    listed = record.get("files", {})
    present = {p.relative_to(external).as_posix()
               for p in external.rglob("*") if p.is_file() and p != record_file}
    for path in sorted(present - listed.keys()):
        problems.append(f"not in EXPORT.toml: external/{path}")
    for path in sorted(listed.keys() - present):
        problems.append(f"missing: external/{path}")
    for path in sorted(present & listed.keys()):
        digest = "sha256:" + hashlib.sha256((external / path).read_bytes()).hexdigest()
        if digest != listed[path]:
            problems.append(f"changed since the export: external/{path}")
    return problems


def main(args):
    if len(args) > 1 or (args and args[0].startswith("-")):
        print(__doc__.strip().splitlines()[-1])
        return 0
    root = Path(args[0]) if args else Path(__file__).resolve().parent
    problems = check(root)
    if problems:
        print("external/ does not hold a clean export:", file=sys.stderr)
        for p in problems:
            print("  " + p, file=sys.stderr)
        return 1
    print("external/ matches EXPORT.toml")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
